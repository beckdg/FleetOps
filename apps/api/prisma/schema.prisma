generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users              User[]              @relation("OrganizationUsers")
  roles              Role[]              @relation("OrganizationRoles")
  vehicles           Vehicle[]           @relation("OrganizationVehicles")
  drivers            Driver[]            @relation("OrganizationDrivers")
  vehicleAssignments VehicleAssignment[] @relation("OrganizationVehicleAssignments")
  trips              Trip[]              @relation("OrganizationTrips")
  maintenanceRecords MaintenanceRecord[] @relation("OrganizationMaintenanceRecords")
  inspections        Inspection[]        @relation("OrganizationInspections")
  fuelStations       FuelStation[]       @relation("OrganizationFuelStations")
  fuelRecords        FuelRecord[]        @relation("OrganizationFuelRecords")
  notifications      Notification[]      @relation("OrganizationNotifications")
  apiKeys              ApiKey[]            @relation("OrganizationApiKeys")
  webhookEndpoints     WebhookEndpoint[]   @relation("OrganizationWebhookEndpoints")
  webhookEvents        WebhookEvent[]      @relation("OrganizationWebhookEvents")
  jobs                 Job[]               @relation("OrganizationJobs")

  @@index([isActive])
  @@map("organizations")
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String
  passwordHash   String    @map("password_hash")
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization  Organization @relation("OrganizationUsers", fields: [organizationId], references: [id], onDelete: Restrict)
  userRoles     UserRole[]   @relation("UserRoleAssignments")
  refreshTokens RefreshToken[] @relation("UserRefreshTokens")
  vehicleAssignmentsCreated VehicleAssignment[] @relation("AssignmentCreatedBy")
  tripsCreated              Trip[]              @relation("TripCreatedBy")
  tripEventsCreated         TripEvent[]         @relation("TripEventCreatedBy")
  maintenanceRecordsCreated MaintenanceRecord[] @relation("MaintenanceCreatedBy")
  maintenanceEventsCreated  MaintenanceEvent[]  @relation("MaintenanceEventCreatedBy")
  inspectionsCreated        Inspection[]        @relation("InspectionCreatedBy")
  fuelRecordsCreated        FuelRecord[]        @relation("FuelRecordCreatedBy")
  notifications             Notification[]      @relation("UserNotifications")
  notificationPreference    NotificationPreference? @relation("UserNotificationPreferences")
  apiKeysCreated            ApiKey[]            @relation("ApiKeyCreatedBy")

  @@unique([organizationId, email], map: "users_organization_id_email_key")
  @@index([organizationId], map: "users_organization_id_idx")
  @@index([deletedAt], map: "users_deleted_at_idx")
  @@index([isActive], map: "users_is_active_idx")
  @@map("users")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization     @relation("OrganizationRoles", fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]       @relation("RoleUserAssignments")
  rolePermissions RolePermission[] @relation("RolePermissionAssignments")

  @@unique([organizationId, name], map: "roles_organization_id_name_key")
  @@index([organizationId], map: "roles_organization_id_idx")
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[] @relation("PermissionRoleAssignments")

  @@unique([resource, action], map: "permissions_resource_action_key")
  @@index([resource], map: "permissions_resource_idx")
  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation("UserRoleAssignments", fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation("RoleUserAssignments", fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId], map: "user_roles_role_id_idx")
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at")

  role       Role       @relation("RolePermissionAssignments", fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation("PermissionRoleAssignments", fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "role_permissions_permission_id_idx")
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation("UserRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "refresh_tokens_user_id_idx")
  @@index([expiresAt], map: "refresh_tokens_expires_at_idx")
  @@index([revokedAt], map: "refresh_tokens_revoked_at_idx")
  @@map("refresh_tokens")
}

enum VehicleStatus {
  ACTIVE
  IN_MAINTENANCE
  OUT_OF_SERVICE
  RETIRED
}

enum DriverStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

model Vehicle {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  plateNumber    String        @map("plate_number")
  vin            String        @unique
  make           String
  model          String
  year           Int
  status         VehicleStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization        @relation("OrganizationVehicles", fields: [organizationId], references: [id], onDelete: Restrict)
  assignments  VehicleAssignment[] @relation("VehicleAssignments")
  trips        Trip[]              @relation("VehicleTrips")
  maintenanceRecords MaintenanceRecord[] @relation("VehicleMaintenanceRecords")
  inspections  Inspection[]        @relation("VehicleInspections")
  fuelRecords  FuelRecord[]        @relation("VehicleFuelRecords")

  @@unique([organizationId, plateNumber], map: "vehicles_organization_id_plate_number_key")
  @@index([organizationId], map: "vehicles_organization_id_idx")
  @@index([organizationId, status], map: "vehicles_organization_id_status_idx")
  @@index([status], map: "vehicles_status_idx")
  @@map("vehicles")
}

model Driver {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  employeeId        String       @map("employee_id")
  firstName         String       @map("first_name")
  lastName          String       @map("last_name")
  licenseNumber     String       @map("license_number")
  licenseExpiryDate DateTime     @map("license_expiry_date") @db.Date
  status            DriverStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  organization Organization        @relation("OrganizationDrivers", fields: [organizationId], references: [id], onDelete: Restrict)
  assignments  VehicleAssignment[] @relation("DriverAssignments")
  trips        Trip[]              @relation("DriverTrips")

  @@unique([organizationId, employeeId], map: "drivers_organization_id_employee_id_key")
  @@unique([organizationId, licenseNumber], map: "drivers_organization_id_license_number_key")
  @@index([organizationId], map: "drivers_organization_id_idx")
  @@index([organizationId, status], map: "drivers_organization_id_status_idx")
  @@index([status], map: "drivers_status_idx")
  @@map("drivers")
}

model VehicleAssignment {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  vehicleId        String    @map("vehicle_id") @db.Uuid
  driverId         String    @map("driver_id") @db.Uuid
  assignedAt       DateTime  @default(now()) @map("assigned_at")
  endedAt          DateTime? @map("ended_at")
  assignedByUserId String    @map("assigned_by_user_id") @db.Uuid

  organization   Organization @relation("OrganizationVehicleAssignments", fields: [organizationId], references: [id], onDelete: Restrict)
  vehicle        Vehicle      @relation("VehicleAssignments", fields: [vehicleId], references: [id], onDelete: Restrict)
  driver         Driver       @relation("DriverAssignments", fields: [driverId], references: [id], onDelete: Restrict)
  assignedByUser User         @relation("AssignmentCreatedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId], map: "vehicle_assignments_organization_id_idx")
  @@index([vehicleId], map: "vehicle_assignments_vehicle_id_idx")
  @@index([driverId], map: "vehicle_assignments_driver_id_idx")
  @@index([endedAt], map: "vehicle_assignments_ended_at_idx")
  @@map("vehicle_assignments")
}

enum TripStatus {
  PLANNED
  DISPATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TripEventType {
  TRIP_CREATED
  TRIP_DISPATCHED
  TRIP_STARTED
  TRIP_COMPLETED
  TRIP_CANCELLED
}

model Trip {
  id               String     @id @default(uuid()) @db.Uuid
  organizationId   String     @map("organization_id") @db.Uuid
  vehicleId        String     @map("vehicle_id") @db.Uuid
  driverId         String     @map("driver_id") @db.Uuid
  tripNumber       String     @map("trip_number")
  origin           String
  destination      String
  scheduledStartAt DateTime   @map("scheduled_start_at")
  scheduledEndAt   DateTime   @map("scheduled_end_at")
  actualStartAt    DateTime?  @map("actual_start_at")
  actualEndAt      DateTime?  @map("actual_end_at")
  status           TripStatus @default(PLANNED)
  createdByUserId  String     @map("created_by_user_id") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  organization  Organization @relation("OrganizationTrips", fields: [organizationId], references: [id], onDelete: Restrict)
  vehicle       Vehicle      @relation("VehicleTrips", fields: [vehicleId], references: [id], onDelete: Restrict)
  driver        Driver       @relation("DriverTrips", fields: [driverId], references: [id], onDelete: Restrict)
  createdByUser User         @relation("TripCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  events        TripEvent[]  @relation("TripEvents")
  fuelRecords   FuelRecord[] @relation("TripFuelRecords")

  @@unique([organizationId, tripNumber], map: "trips_organization_id_trip_number_key")
  @@index([organizationId], map: "trips_organization_id_idx")
  @@index([organizationId, status], map: "trips_organization_id_status_idx")
  @@index([vehicleId], map: "trips_vehicle_id_idx")
  @@index([driverId], map: "trips_driver_id_idx")
  @@index([scheduledStartAt, scheduledEndAt], map: "trips_schedule_idx")
  @@index([status], map: "trips_status_idx")
  @@map("trips")
}

model TripEvent {
  id              String        @id @default(uuid()) @db.Uuid
  tripId          String        @map("trip_id") @db.Uuid
  eventType       TripEventType @map("event_type")
  notes           String?
  createdByUserId String        @map("created_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")

  trip          Trip @relation("TripEvents", fields: [tripId], references: [id], onDelete: Cascade)
  createdByUser User @relation("TripEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([tripId], map: "trip_events_trip_id_idx")
  @@index([eventType], map: "trip_events_event_type_idx")
  @@index([createdAt], map: "trip_events_created_at_idx")
  @@map("trip_events")
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  EMERGENCY
}

enum MaintenanceEventType {
  MAINTENANCE_SCHEDULED
  MAINTENANCE_STARTED
  MAINTENANCE_COMPLETED
  MAINTENANCE_CANCELLED
}

model MaintenanceRecord {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  vehicleId       String            @map("vehicle_id") @db.Uuid
  title           String
  description     String?
  maintenanceType MaintenanceType   @map("maintenance_type")
  scheduledAt     DateTime          @map("scheduled_at")
  startedAt       DateTime?         @map("started_at")
  completedAt     DateTime?         @map("completed_at")
  status          MaintenanceStatus @default(SCHEDULED)
  estimatedCost   Decimal?          @map("estimated_cost") @db.Decimal(12, 2)
  actualCost      Decimal?          @map("actual_cost") @db.Decimal(12, 2)
  createdByUserId String            @map("created_by_user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  organization  Organization      @relation("OrganizationMaintenanceRecords", fields: [organizationId], references: [id], onDelete: Restrict)
  vehicle       Vehicle           @relation("VehicleMaintenanceRecords", fields: [vehicleId], references: [id], onDelete: Restrict)
  createdByUser User              @relation("MaintenanceCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  events        MaintenanceEvent[] @relation("MaintenanceRecordEvents")

  @@index([organizationId], map: "maintenance_records_organization_id_idx")
  @@index([organizationId, status], map: "maintenance_records_organization_id_status_idx")
  @@index([vehicleId], map: "maintenance_records_vehicle_id_idx")
  @@index([vehicleId, status], map: "maintenance_records_vehicle_id_status_idx")
  @@index([scheduledAt], map: "maintenance_records_scheduled_at_idx")
  @@map("maintenance_records")
}

model MaintenanceEvent {
  id                  String               @id @default(uuid()) @db.Uuid
  maintenanceRecordId String               @map("maintenance_record_id") @db.Uuid
  eventType           MaintenanceEventType @map("event_type")
  notes               String?
  createdByUserId     String               @map("created_by_user_id") @db.Uuid
  createdAt           DateTime             @default(now()) @map("created_at")

  maintenanceRecord MaintenanceRecord @relation("MaintenanceRecordEvents", fields: [maintenanceRecordId], references: [id], onDelete: Cascade)
  createdByUser     User              @relation("MaintenanceEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([maintenanceRecordId], map: "maintenance_events_maintenance_record_id_idx")
  @@index([eventType], map: "maintenance_events_event_type_idx")
  @@index([createdAt], map: "maintenance_events_created_at_idx")
  @@map("maintenance_events")
}

model Inspection {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  vehicleId       String   @map("vehicle_id") @db.Uuid
  inspectionDate  DateTime @map("inspection_date") @db.Date
  passed          Boolean
  notes           String?
  inspectorName   String   @map("inspector_name")
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  organization  Organization @relation("OrganizationInspections", fields: [organizationId], references: [id], onDelete: Restrict)
  vehicle       Vehicle      @relation("VehicleInspections", fields: [vehicleId], references: [id], onDelete: Restrict)
  createdByUser User         @relation("InspectionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId], map: "inspections_organization_id_idx")
  @@index([vehicleId], map: "inspections_vehicle_id_idx")
  @@index([inspectionDate], map: "inspections_inspection_date_idx")
  @@index([passed], map: "inspections_passed_idx")
  @@map("inspections")
}

model FuelStation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  location       String
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation("OrganizationFuelStations", fields: [organizationId], references: [id], onDelete: Restrict)
  fuelRecords  FuelRecord[] @relation("FuelStationRecords")

  @@unique([organizationId, name], map: "fuel_stations_organization_id_name_key")
  @@index([organizationId], map: "fuel_stations_organization_id_idx")
  @@map("fuel_stations")
}

model FuelRecord {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  vehicleId        String   @map("vehicle_id") @db.Uuid
  tripId           String?  @map("trip_id") @db.Uuid
  fuelStationId    String?  @map("fuel_station_id") @db.Uuid
  odometerReading  Int      @map("odometer_reading")
  litersPurchased  Decimal  @map("liters_purchased") @db.Decimal(10, 3)
  pricePerLiter    Decimal  @map("price_per_liter") @db.Decimal(12, 4)
  totalCost        Decimal  @map("total_cost") @db.Decimal(12, 2)
  filledAt         DateTime @map("filled_at")
  createdByUserId  String   @map("created_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  organization  Organization @relation("OrganizationFuelRecords", fields: [organizationId], references: [id], onDelete: Restrict)
  vehicle       Vehicle      @relation("VehicleFuelRecords", fields: [vehicleId], references: [id], onDelete: Restrict)
  trip          Trip?        @relation("TripFuelRecords", fields: [tripId], references: [id], onDelete: Restrict)
  fuelStation   FuelStation? @relation("FuelStationRecords", fields: [fuelStationId], references: [id], onDelete: Restrict)
  createdByUser User         @relation("FuelRecordCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId], map: "fuel_records_organization_id_idx")
  @@index([vehicleId], map: "fuel_records_vehicle_id_idx")
  @@index([vehicleId, filledAt], map: "fuel_records_vehicle_id_filled_at_idx")
  @@index([tripId], map: "fuel_records_trip_id_idx")
  @@index([fuelStationId], map: "fuel_records_fuel_station_id_idx")
  @@index([filledAt], map: "fuel_records_filled_at_idx")
  @@map("fuel_records")
}

enum NotificationType {
  TRIP_STARTED
  TRIP_COMPLETED
  MAINTENANCE_STARTED
  MAINTENANCE_COMPLETED
  INSPECTION_FAILED
  FUEL_RECORD_CREATED
  SYSTEM
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  type           NotificationType
  title          String
  message        String
  readAt         DateTime?        @map("read_at")
  metadata       Json?
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization @relation("OrganizationNotifications", fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation("UserNotifications", fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId], map: "notifications_organization_id_idx")
  @@index([userId], map: "notifications_user_id_idx")
  @@index([userId, readAt], map: "notifications_user_id_read_at_idx")
  @@index([type], map: "notifications_type_idx")
  @@index([createdAt], map: "notifications_created_at_idx")
  @@map("notifications")
}

model NotificationPreference {
  id                       String   @id @default(uuid()) @db.Uuid
  userId                   String   @unique @map("user_id") @db.Uuid
  tripNotifications        Boolean  @default(true) @map("trip_notifications")
  maintenanceNotifications Boolean  @default(true) @map("maintenance_notifications")
  inspectionNotifications  Boolean  @default(true) @map("inspection_notifications")
  fuelNotifications        Boolean  @default(true) @map("fuel_notifications")
  systemNotifications      Boolean  @default(true) @map("system_notifications")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  user User @relation("UserNotificationPreferences", fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

model ApiKey {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  name            String
  keyPrefix       String    @map("key_prefix")
  hashedKey       String    @unique @map("hashed_key")
  lastUsedAt      DateTime? @map("last_used_at")
  expiresAt       DateTime? @map("expires_at")
  isActive        Boolean   @default(true) @map("is_active")
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization  Organization @relation("OrganizationApiKeys", fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser User         @relation("ApiKeyCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, name], map: "api_keys_organization_id_name_key")
  @@index([organizationId, isActive], map: "api_keys_organization_id_is_active_idx")
  @@index([keyPrefix], map: "api_keys_key_prefix_idx")
  @@map("api_keys")
}

model WebhookEndpoint {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  url            String
  secret         String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization      @relation("OrganizationWebhookEndpoints", fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries     WebhookDelivery[] @relation("EndpointWebhookDeliveries")

  @@unique([organizationId, name], map: "webhook_endpoints_organization_id_name_key")
  @@index([organizationId, isActive], map: "webhook_endpoints_organization_id_is_active_idx")
  @@map("webhook_endpoints")
}

model WebhookEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  eventType      String   @map("event_type")
  payload        Json
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization      @relation("OrganizationWebhookEvents", fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[] @relation("EventWebhookDeliveries")

  @@index([organizationId], map: "webhook_events_organization_id_idx")
  @@index([eventType], map: "webhook_events_event_type_idx")
  @@index([createdAt], map: "webhook_events_created_at_idx")
  @@map("webhook_events")
}

model WebhookDelivery {
  id                 String                @id @default(uuid()) @db.Uuid
  webhookEndpointId  String                @map("webhook_endpoint_id") @db.Uuid
  webhookEventId     String                @map("webhook_event_id") @db.Uuid
  attemptNumber      Int                   @map("attempt_number")
  status             WebhookDeliveryStatus
  responseCode       Int?                  @map("response_code")
  responseBody       String?               @map("response_body")
  deliveredAt        DateTime?             @map("delivered_at")
  createdAt          DateTime              @default(now()) @map("created_at")

  webhookEndpoint WebhookEndpoint @relation("EndpointWebhookDeliveries", fields: [webhookEndpointId], references: [id], onDelete: Cascade)
  webhookEvent    WebhookEvent    @relation("EventWebhookDeliveries", fields: [webhookEventId], references: [id], onDelete: Cascade)

  @@index([webhookEndpointId], map: "webhook_deliveries_webhook_endpoint_id_idx")
  @@index([webhookEventId], map: "webhook_deliveries_webhook_event_id_idx")
  @@index([status], map: "webhook_deliveries_status_idx")
  @@map("webhook_deliveries")
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum JobType {
  WEBHOOK_DELIVERY
  NOTIFICATION
  LICENSE_EXPIRY_REMINDER
  MAINTENANCE_REMINDER
  REPORT_GENERATION
}

model Job {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  type           JobType
  status         JobStatus @default(PENDING)
  attemptCount   Int       @default(0) @map("attempt_count")
  payload        Json
  result         Json?
  failureReason  String?   @map("failure_reason")
  bullJobId      String?   @map("bull_job_id")
  queueName      String    @map("queue_name")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation("OrganizationJobs", fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status], map: "jobs_organization_id_status_idx")
  @@index([type], map: "jobs_type_idx")
  @@index([queueName], map: "jobs_queue_name_idx")
  @@index([createdAt], map: "jobs_created_at_idx")
  @@map("jobs")
}
