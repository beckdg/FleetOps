# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://fleetops:fleetops@localhost:5433/fleetops?schema=public
DATABASE_URL_TEST=postgresql://fleetops:fleetops@localhost:5433/fleetops_test?schema=public

# Authentication (placeholders — required before auth/RBAC implementation)
JWT_SECRET=fleetops-dev-jwt-secret-change-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis (required for BullMQ background jobs)
REDIS_URL=redis://localhost:6379
