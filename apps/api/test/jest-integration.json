{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "./integration",
  "testEnvironment": "node",
  "testRegex": ".integration.spec.ts$",
  "setupFiles": ["<rootDir>/setup-integration.ts"],
  "globalSetup": "<rootDir>/global-setup.ts",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/../../src/$1"
  },
  "testPathIgnorePatterns": ["/node_modules/", "/dist/"]
}
