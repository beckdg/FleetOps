# Application (Docker Compose defaults — override in .env.docker for production)
NODE_ENV=production
PORT=3000
APP_VERSION=0.1.0

# Database (host port 5433 maps to postgres service)
DATABASE_URL=postgresql://fleetops:fleetops@postgres:5432/fleetops?schema=public

# Redis
REDIS_URL=redis://redis:6379

# Authentication — must NOT use the dev placeholder when NODE_ENV=production
JWT_SECRET=fleetops-docker-compose-secret-change-before-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Migrations — set false to skip automatic migrate on container start
RUN_MIGRATIONS=true

# Optional seed after first deploy (manual): docker compose exec api prisma db seed
