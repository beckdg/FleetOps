{
  "name": "fleetops",
  "version": "0.1.0",
  "private": true,
  "description": "Fleet and logistics management platform",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "test": "pnpm --filter @fleetops/api test",
    "test:cov": "pnpm --filter @fleetops/api test:cov",
    "test:integration": "pnpm --filter @fleetops/api test:integration",
    "test:e2e": "pnpm --filter @fleetops/api test:e2e",
    "start:dev": "pnpm --filter @fleetops/api start:dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "@fleetops/eslint-config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
